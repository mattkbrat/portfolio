---
import Default from "@astrojs/starlight/components/Hero.astro";
const { links } = Astro.locals.starlightRoute.entry.data;
---

<div class="hero-wrapper">
    <Default>
        <slot />
    </Default>
    <div class="page-links">
        {links?.map((l) => <a href={l}>{l}</a>)}
    </div>
</div>
