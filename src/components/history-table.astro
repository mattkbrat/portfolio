---
const { id, title, startDate, endDate, description, href, hidden } =
    Astro.props;
---

<div
    id={title.replaceAll(" ", "").replaceAll(".", "").toLowerCase()}
    class:list={[{ hidden: hidden, project: !hidden }]}
>
    <h2 class="sl-heading-wrapper level-h2 flex justify-between history-table">
        {href ? (
            <a class="print:underline" href={href}>
                {title}
            </a>
        ) : (
            <span class="print:underline">{title}</span>
        )}
        {startDate && (
            <span class="text-base ml-auto font-medium!">
                {startDate}
                {endDate === "" ? "" : ` – ${endDate ?? "Present"}`}
            </span>
        )}
    </h2>
    <div class="col-span-full italic">{description}</div>
    <div class="col-span-full">
        <slot />
    </div>
</div>
