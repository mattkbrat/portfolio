---
const { id, title, startDate, endDate, description, href, hidden } =
    Astro.props;
---

<table id={id} class:list={[{ hidden: hidden }]}>
    <tbody>
        <tr>
            <th class="sl-heading-wrapper level-h2">
                {href ? <a href={href}>{title}</a> : <span>{title}</span>}
            </th>
            {
                startDate && (
                    <th class="date">
                        {startDate}
                        {endDate === "" ? "" : ` – ${endDate ?? "Current"}`}
                    </th>
                )
            }
        </tr>
        <tr>
            <td colspan="2">
                {description}
            </td>
        </tr>
        <tr>
            <td colspan="2" class="content"> <slot /> </td>
        </tr>
    </tbody>
</table>
<style>
    table {
        width: 100%;
        table-layout: fixed;
    }
    tbody {
        display: table;
        width: 100%;
    }
    .date {
        font-weight: normal;
        text-align: right;
    }
    td,
    th {
        border-bottom: 0px transparent;
        padding: 0px;
    }
    tr > td:not(.content) {
        font-style: italic;
        padding: 0px;
    }
</style>
