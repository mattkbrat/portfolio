---
const {
    id,
    title,
    startDate,
    endDate,
    description,
    href,
    hidden,
    PopoverContent,
} = Astro.props;
import Search from "./icons/search.astro";

const isSmppStack = id === "smpp-stack";
---

<div id={id} class:list={[{ hidden: hidden, project: !hidden }]}>
    <h2 class="sl-heading-wrapper level-h2">
        {
            href ? (
                <a href={href}>{title}</a>
            ) : isSmppStack ? (
                <div class="flex gap-1 items-end">
                    <a href="/projects/smpp">{title}</a>
                    <button
                        type="button"
                        popovertarget={`${id}-mermaid`}
                        class="ghost underline flex gap-1"
                    >
                        <Search />
                    </button>
                </div>
            ) : (
                <span>{title}</span>
            )
        }
    </h2>
    {
        startDate && (
            <span class="date">
                {startDate}
                {endDate === "" ? "" : ` – ${endDate ?? "Current"}`}
            </span>
        )
    }
    <div class="col-span-full">
        {description}
    </div>
    <div class="col-span-full"><slot /></div>
</div>
{
    isSmppStack && PopoverContent && (
        <div
            popover
            id={`${id}-mermaid`}
            class="mermaid popover max-h-[60dvh] lg:max-h-[90dvh] m-auto overflow-auto outline-2 rounded-sm shadow-sm sl-container bg-[#f5f5f5] dark:bg-[#0c0808]"
        >
            <PopoverContent />
        </div>
    )
}
